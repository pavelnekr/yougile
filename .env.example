NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://portal:portal@localhost:5432/yougile_portal?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-secret
# Ключ самостоятельной регистрации в портале. Пусто — регистрация выключена.
REGISTRATION_KEY=replace-with-registration-key
YOUGILE_API_URL=https://your-yougile-host/api-v2
# Обязателен для добавления персональных токенов YouGile; не меняйте, пока они сохранены в БД.
# 32 случайных байта в hex. Сгенерируйте командой: openssl rand -hex 32
YOUGILE_TOKEN_ENCRYPTION_KEY=
# ID колонки YouGile с активными задачами («Фильтрация»).
# Укажите UUID из вашего YouGile — этот пример-заглушка не рабочая.
YOUGILE_PLAN_COLUMN_ID=11111111-1111-4111-8111-111111111111
UPLOAD_MAX_BYTES=10485760

# --- SMTP раздела «Согласование/Оповещение» ---
# Пустой SMTP_HOST — почта не настроена: письмо собирается и показывается
# в предпросмотре, но отправка отвечает понятной ошибкой.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# От кого письмо; пусто — берётся SMTP_USER. Пример: daps-agent@dcoa.ru
SMTP_FROM=

# --- Только для docker-compose.prod.yml (docker-compose.yml эти не читает) ---
# Порт веба снаружи. Если его занимает nginx/Caddy хоста, поставьте 8080
# и проксируйте на него.
WEB_PORT=80
# Postgres из compose. DATABASE_URL выше для локальной разработки,
# в контейнерах он собирается автоматически из этих трёх переменных.
POSTGRES_DB=yougile_portal
POSTGRES_USER=portal
POSTGRES_PASSWORD=change-me-to-a-long-random-password
