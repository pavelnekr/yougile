generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PortalRole {
  ADMIN
  OPERATOR
  VIEWER
}

enum OperationType {
  ASSIGN
  REMOVE
  COMMENT
  REASSIGN
  AUDIT
  USER_SYNC
  IMPORT
}

enum OperationStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
  CANCELLED
}

enum OperationItemStatus {
  PENDING
  SUCCEEDED
  FAILED
  SKIPPED
}

enum ImportBatchStatus {
  PREVIEW
  ASSIGNING
  COMPLETE
}

enum ImportRowStatus {
  READY
  SITE_NOT_FOUND
  ENGINEER_NOT_FOUND
  INVALID_ROW
  DUPLICATE_SITE
}

model PortalUser {
  id                    String          @id @default(cuid())
  login                 String          @unique
  passwordHash          String
  displayName           String
  role                  PortalRole      @default(OPERATOR)
  active                Boolean         @default(true)
  yougileTokenEncrypted String?
  operations            Operation[]     @relation("CreatedOperations")
  imports               ImportBatch[]
  sessions              PortalSession[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
}

// Сессия входа: сам токен живёт только в httpOnly-cookie, в базе хранится его SHA-256.
model PortalSession {
  id         String     @id @default(cuid())
  tokenHash  String     @unique
  userId     String
  user       PortalUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String?
  expiresAt  DateTime
  createdAt  DateTime   @default(now())
  lastSeenAt DateTime   @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model YougileUser {
  id        String     @id
  name      String
  email     String?
  active    Boolean    @default(true)
  siteTasks SiteTask[]
  syncedAt  DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model SiteTask {
  id              String          @id @default(cuid())
  siteId          String          @unique
  yougileTaskId   String?
  yougileUserId   String?
  yougileUser     YougileUser?    @relation(fields: [yougileUserId], references: [id], onDelete: SetNull)
  address         String?
  cluster         String?
  scheduledAt     String?
  workRequired    String?
  comment         String?
  assignedUserIds Json?
  rawData         Json
  importedAt      DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  operationItems  OperationItem[]

  @@index([yougileTaskId])
  @@index([yougileUserId])
  @@index([cluster])
}

model Operation {
  id          String          @id @default(cuid())
  type        OperationType
  status      OperationStatus @default(QUEUED)
  createdById String?
  createdBy   PortalUser?     @relation("CreatedOperations", fields: [createdById], references: [id], onDelete: SetNull)
  total       Int             @default(0)
  completed   Int             @default(0)
  failed      Int             @default(0)
  message     String?
  metadata    Json?
  items       OperationItem[]
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime        @default(now())

  @@index([createdById, createdAt])
  @@index([status, createdAt])
}

model OperationItem {
  id              String              @id @default(cuid())
  operationId     String
  operation       Operation           @relation(fields: [operationId], references: [id], onDelete: Cascade)
  importRowId     String?
  importRow       ImportRow?          @relation(fields: [importRowId], references: [id], onDelete: SetNull)
  siteTaskId      String?
  siteTask        SiteTask?           @relation(fields: [siteTaskId], references: [id], onDelete: SetNull)
  siteId          String
  status          OperationItemStatus @default(PENDING)
  requestedUserId String?
  beforeData      Json?
  afterData       Json?
  errorCode       String?
  errorMessage    String?
  attempts        Int                 @default(0)
  completedAt     DateTime?
  createdAt       DateTime            @default(now())

  @@unique([operationId, siteId])
  @@index([operationId, status])
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model ImportBatch {
  id          String            @id @default(cuid())
  fileName    String
  checksum    String
  rowCount    Int               @default(0)
  createdById String?
  createdBy   PortalUser?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  status      ImportBatchStatus @default(PREVIEW)
  rows        ImportRow[]
  metadata    Json?
  createdAt   DateTime          @default(now())

  @@index([checksum])
  @@index([createdAt])
}

model ImportRow {
  id             String          @id @default(cuid())
  importBatchId  String
  importBatch    ImportBatch     @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  rowNumber      Int
  siteId         String?
  address        String?
  engineerName   String?
  engineerUserId String?
  yougileTaskId  String?
  status         ImportRowStatus
  rawData        Json
  operationItems OperationItem[]
  createdAt      DateTime        @default(now())

  @@unique([importBatchId, rowNumber])
  @@index([importBatchId, status])
  @@index([siteId])
}
