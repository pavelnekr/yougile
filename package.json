{
  "name": "yougile-operations-portal",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/shared"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev --workspace @portal/api\" \"npm run dev --workspace @portal/web\"",
    "build": "npm run db:generate && npm run build --workspace @portal/api && npm run build --workspace @portal/web",
    "db:generate": "dotenv -e .env -- npm run db:generate --workspace @portal/api",
    "db:migrate": "dotenv -e .env -- npm run db:migrate --workspace @portal/api",
    "db:studio": "dotenv -e .env -- npm run db:studio --workspace @portal/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "dotenv-cli": "^8.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
